# Oracle Cloud Infrastructure Configuration
# Copy this file to .env and fill in your values
# Then run: ./scripts/setup.sh

# ──────────────────────────────────────────────
# Required: OCI Account Information
# ──────────────────────────────────────────────

# Tenancy OCID (Profile → Tenancy → Copy OCID)
OCI_TENANCY_OCID=ocid1.tenancy.oc1..xxxxx

# User OCID (Profile → User Settings → Copy OCID)
OCI_USER_OCID=ocid1.user.oc1..xxxxx

# API Key Fingerprint (shown after uploading public key)
OCI_FINGERPRINT=xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx

# Object Storage Namespace (Profile → Tenancy → Object storage namespace)
OCI_NAMESPACE=your-namespace

# Home Region (e.g., ap-singapore-1, ap-tokyo-1, us-ashburn-1)
OCI_REGION=ap-singapore-1

# ──────────────────────────────────────────────
# Required: S3-Compatible Access (for Terraform Remote State)
# ──────────────────────────────────────────────

# Customer Secret Key Access Key (User Settings → Customer Secret Keys)
OCI_S3_ACCESS_KEY=your-access-key

# Customer Secret Key Secret (shown only once when created)
OCI_S3_SECRET_KEY=your-secret-key

# ──────────────────────────────────────────────
# Required: Notifications
# ──────────────────────────────────────────────

# Email for budget alerts
BUDGET_ALERT_EMAIL=your-email@example.com

# ──────────────────────────────────────────────
# Optional: Key Paths (defaults shown)
# ──────────────────────────────────────────────

# OCI_API_KEY_PATH=~/.ssh/oci_api_key.pem
# OCI_SSH_KEY_PATH=~/.ssh/id_rsa_oracle_cloud
